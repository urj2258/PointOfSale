{
  "name": "pos",
  "private": true,
  "version": "1.1.3",
  "description": "Point of Sale Desktop Application",
  "author": "Shahzeb",
  "type": "module",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "cross-env TEMP=D:\\npm-temp TMP=D:\\npm-temp npm-run-all --parallel dev:react dev:electron",
    "dev:react": "vite",
    "dev:electron": "wait-on http://localhost:5132 && npm run transpile:electron && cross-env NODE_ENV=development electron .",
    "build": "cross-env TEMP=D:\\npm-temp TMP=D:\\npm-temp tsc -b && vite build",
    "test": "vitest run",
    "lint": "eslint .",
    "preview": "vite preview",
    "seed:owner": "cross-env TEMP=D:\\npm-temp TMP=D:\\npm-temp node scripts/seed-owner.js",
    "seed:owner:force": "cross-env TEMP=D:\\npm-temp TMP=D:\\npm-temp node scripts/seed-owner.js --force",
    "seed:test-data": "cross-env TEMP=D:\\npm-temp TMP=D:\\npm-temp node scripts/seed-test-data.js",
    "transpile:electron": "tsc --project src/electron/tsconfig.json",
    "dist:mac": "npm run transpile:electron && npm run build && electron-builder --mac --arm64",
    "dist:win": "cross-env TEMP=D:\\npm-temp TMP=D:\\npm-temp npm run transpile:electron && npm run build && electron-builder --win --x64",
    "dist:linux": "npm run transpile:electron && npm run build && electron-builder --linux --x64"
  },
  "dependencies": {
    "@libsql/client": "^0.15.0",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^12.11.1",
    "dotenv": "^17.4.2",
    "exceljs": "^4.4.0",
    "react": "^19.2.7",
    "react-datepicker": "^9.1.0",
    "react-dom": "^19.2.7",
    "react-hot-toast": "^2.6.0",
    "react-router-dom": "^7.18.0"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.1.0",
    "@eslint/js": "^10.0.1",
    "@types/bcrypt": "^6.0.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-datepicker": "^6.2.0",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "autoprefixer": "^10.5.2",
    "cross-env": "^10.1.0",
    "electron": "^42.5.0",
    "electron-builder": "^26.15.3",
    "eslint": "^10.5.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.6.0",
    "npm-run-all": "^4.1.5",
    "postcss": "^8.5.15",
    "sql.js": "^1.14.1",
    "tailwindcss": "^3.4.19",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.61.0",
    "vite": "^8.1.0",
    "vitest": "^4.1.10",
    "wait-on": "^9.0.10"
  }
}
